  <DataSources>
    <DataSource Name="DealershipDB">
      <DataSourceReference>DealershipDB</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6e3947c2-ceb9-4d24-b4db-7b57eb937886</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="AgingInventory">
      <Query>
        <DataSourceName>DealershipDB</DataSourceName>
        <CommandText>SELECT TOP 15
    mk.MakeName,
    md.ModelName,
    v.Trim,
    v.Price,
    il.EventDate AS ArrivalDate,
    DATEDIFF(DAY, il.EventDate, GETDATE()) AS DaysOnLot
FROM Vehicles v
JOIN Models md ON v.ModelID = md.ModelID
JOIN Makes mk ON md.MakeID = mk.MakeID
JOIN InventoryLog il ON v.VIN = il.VIN
WHERE v.Status = 'In Stock'
  AND il.EventType IN ('Arrived - New', 'Arrived - Trade-In')
ORDER BY DaysOnLot DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="MakeName">
          <DataField>MakeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ModelName">
          <DataField>ModelName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Trim">
          <DataField>Trim</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price">
          <DataField>Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ArrivalDate">
          <DataField>ArrivalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DaysOnLot">
          <DataField>DaysOnLot</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
