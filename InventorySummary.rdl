  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>DealershipDB</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>db628444-66bd-40f5-ae71-6b5d6ea14873</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InventorySummary">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MakeName">
            <Value>=Parameters!MakeName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    mk.MakeName,
    md.ModelName,
    COUNT(*) AS UnitsInStock
FROM Vehicles v
JOIN Models md ON v.ModelID = md.ModelID
JOIN Makes mk ON md.MakeID = mk.MakeID
WHERE v.Status = 'In Stock'
  AND (mk.MakeName = @MakeName OR @MakeName = 'All')
GROUP BY mk.MakeName, md.ModelName
ORDER BY mk.MakeName, UnitsInStock DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="MakeName">
          <DataField>MakeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ModelName">
          <DataField>ModelName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UnitsInStock">
          <DataField>UnitsInStock</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MakeList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 0 AS SortOrder, 'All' AS MakeName
UNION
SELECT 1 AS SortOrder, MakeName FROM Makes
ORDER BY SortOrder, MakeName;</CommandText>
      </Query>
      <Fields>
        <Field Name="SortOrder">
          <DataField>SortOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MakeName">
          <DataField>MakeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
