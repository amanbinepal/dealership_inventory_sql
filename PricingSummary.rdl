  <DataSources>
    <DataSource Name="DealershipDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLEXPRESS;Initial Catalog=DealershipDB</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>d26ec393-d1fa-43e0-9ba5-6ef1d6edd630</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="PricingSummary">
      <Query>
        <DataSourceName>DealershipDB</DataSourceName>
        <CommandText>SELECT
    mk.MakeName,
    md.ModelName,
    COUNT(*) AS UnitsOnLot,
    ROUND(AVG(v.Price), 2) AS AvgPrice,
    ROUND(AVG(v.Mileage), 0) AS AvgMileage
FROM Vehicles v
JOIN Models md ON v.ModelID = md.ModelID
JOIN Makes mk ON md.MakeID = mk.MakeID
WHERE v.Status &lt;&gt; 'Sold'
GROUP BY mk.MakeName, md.ModelName
ORDER BY mk.MakeName, md.ModelName;</CommandText>
      </Query>
      <Fields>
        <Field Name="MakeName">
          <DataField>MakeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ModelName">
          <DataField>ModelName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UnitsOnLot">
          <DataField>UnitsOnLot</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AvgPrice">
          <DataField>AvgPrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AvgMileage">
          <DataField>AvgMileage</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
